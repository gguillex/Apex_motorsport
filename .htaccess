# Cuando el servidor no puede apuntar directamente a public/ (hosting
# compartido, XAMPP…), todas las peticiones se sirven desde public/ y las URL
# quedan limpias: /coche.php -> public/coche.php.
# El resto de carpetas (src, templates, config, database…) nunca son accesibles.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>
